<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MiniMeLi.Views.LoginPage"
             Title="Iniciar sesión"
             BackgroundColor="{StaticResource Background}">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="14" VerticalOptions="Center">

            <Label Text="¡Bienvenido!"
                   FontSize="26" FontAttributes="Bold"
                   HorizontalOptions="Center"
                   TextColor="{StaticResource Texto}" />
            <Label Text="Iniciá sesión para continuar"
                   HorizontalOptions="Center" TextColor="Gray" />

            <Border StrokeShape="RoundRectangle 10" Padding="12,0"
                    Stroke="{StaticResource StrokeColor}"
                    BackgroundColor="{StaticResource White}">
                <Entry Placeholder="Email" Keyboard="Email" MaxLength="100"
                       Text="{Binding Email}" />
            </Border>

            <Border StrokeShape="RoundRectangle 10" Padding="12,0"
                    Stroke="{StaticResource StrokeColor}"
                    BackgroundColor="{StaticResource White}">
                <Entry Placeholder="Contraseña" IsPassword="True"
                       Text="{Binding Password}"
                       ReturnCommand="{Binding IniciarSesionCommand}" />
            </Border>

            <Label Text="{Binding MensajeError}"
                   IsVisible="{Binding HayError}"
                   TextColor="{StaticResource acento}"
                   HorizontalTextAlignment="Center" />

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />

            <Button Text="Ingresar" Command="{Binding IniciarSesionCommand}" />

            <Button Text="Crear cuenta"
                    Command="{Binding IrARegistroCommand}"
                    BackgroundColor="Transparent"
                    BorderWidth="1"
                    BorderColor="{StaticResource Texto}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>