<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MiniMeLi.ViewModels"
             x:Class="MiniMeLi.Views.CarritoPage"
             Title="Mi Carrito"
             BackgroundColor="{StaticResource Background}">

    <Grid RowDefinitions="*,Auto" Padding="12">

        <CollectionView ItemsSource="{Binding Items}" Margin="8,10" Grid.Row="0">

            <CollectionView.EmptyView>
                <Label Text="Tu carrito está vacío"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,5" Padding="10"
                            StrokeShape="RoundRectangle 10"
                            BackgroundColor="{StaticResource White}">
                        <Grid ColumnDefinitions="80,*,Auto" ColumnSpacing="10">

                            <Image Source="{Binding Producto.ImagenUrl}"
                                   Aspect="AspectFit"
                                   HeightRequest="80" />

                            <VerticalStackLayout Grid.Column="1" Spacing="5" VerticalOptions="Center">
                                <Label Text="{Binding Producto.Descripcion}" FontAttributes="Bold" MaxLines="2" LineBreakMode="TailTruncation" />
                                <Label Text="{Binding Producto.Precio, StringFormat='{0:c} c/u'}" FontSize="12" TextColor="Gray" />

                                <HorizontalStackLayout Spacing="10">
                                    <Button Text="−" WidthRequest="32" HeightRequest="32"
                                            MinimumWidthRequest="32" MinimumHeightRequest="32"
                                            Padding="0" FontSize="16"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CarritoViewModel}}, Path=DisminuirCommand}"
                                            CommandParameter="{Binding .}" />
                                    <Label Text="{Binding Cantidad}" VerticalOptions="Center" FontAttributes="Bold" />
                                    <Button Text="+" WidthRequest="32" HeightRequest="32"
                                            MinimumWidthRequest="32" MinimumHeightRequest="32"
                                            Padding="0" FontSize="16"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CarritoViewModel}}, Path=AumentarCommand}"
                                            CommandParameter="{Binding .}" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="2" Spacing="8" VerticalOptions="Center" HorizontalOptions="End">
                                <Label Text="{Binding Subtotal, StringFormat='{0:c}'}"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource Verde}"
                                       HorizontalOptions="End" />
                                <Button ImageSource="contenedor_basura.png"
                                        Padding="5"
                                        MinimumHeightRequest="40"
                                        BackgroundColor="{StaticResource acento}"
                                        CornerRadius="10"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CarritoViewModel}}, Path=QuitarCommand}"
                                        CommandParameter="{Binding .}" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <VerticalStackLayout Grid.Row="1" Spacing="8" Padding="0,8">
            <HorizontalStackLayout Spacing="5" HorizontalOptions="Center">
                <Label Text="Productos:" FontAttributes="Bold" />
                <Label Text="{Binding Cantidad}" FontAttributes="Bold" />
                <Label Text="  Total:" FontAttributes="Bold" />
                <Label Text="{Binding Total, StringFormat='{0:c} ARS'}" FontAttributes="Bold" TextColor="{StaticResource Verde}" />
            </HorizontalStackLayout>

            <Button Text="Vaciar carrito"
                    IsVisible="{Binding HayItems}"
                    Command="{Binding VaciarCommand}"
                    BackgroundColor="{StaticResource acento}"
                    TextColor="White" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>